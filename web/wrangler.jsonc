{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drip-web",
  "compatibility_date": "2026-10-20",
  // Static files only: build.sh writes the pages and the engine to dist.
  "assets": { "directory": "./dist" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "drip.jrnxf.co", "custom_domain": true }],
}
